# ── Supabase ──────────────────────────────────────────────
# Project URL + anon key (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Postgres connection string (Settings → Database) — for schema/seed scripts
SUPABASE_DB_URL=

# ── Payments (provider is auto-detected; PAYMENT_PROVIDER=dodo|polar forces one) ──
# Dodo Payments (https://dodopayments.com) — MoR, accepts EG/SA/AE merchants,
# no "directories and boards" restriction. Dashboard: create a Pay-What-You-Want
# product with a $1 minimum (per-checkout amounts = bid / raise difference).
DODO_API_KEY=
DODO_PRODUCT_ID=
DODO_WEBHOOK_SECRET=
DODO_ENVIRONMENT=test_mode   # test_mode | live_mode
# webhook endpoint to register: https://yourdomain.com/api/webhooks/dodo
#   → subscribe to payment.succeeded

# Polar (https://polar.sh) — appeal pending the "directories and boards" review
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
# Product ID of the "Outbid Spot" product (custom-price enabled)
POLAR_PRODUCT_ID=
# Environment: sandbox | production
POLAR_ENVIRONMENT=sandbox

# ── Site ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Dev fallbacks ───────────────────────────────────────
# When true the site runs fully self-contained: seeded data, simulated
# realtime and a mock checkout. No Supabase/Polar keys needed.
NEXT_PUBLIC_MOCK_MODE=true

# ── Site ────────────────────────────────────────────────
# Optional: public launch timestamp used by the earnings card / about page
# (defaults to 2026-08-21T20:00:00Z)
NEXT_PUBLIC_LAUNCH_DATE=

# Layer 2 (local Supabase + mock payments): true = rules engine writes to a
# real database without Polar configured. Local only — never in production.
ALLOW_MOCK_PAYMENTS=

# ── Analytics: DataFast (public stats — parity with reference's link) ──
# Server-side API token (not NEXT_PUBLIC). Either:
#   df_…  website API key (website implied — DATAFAST_WEBSITE_ID not needed)
#   dft_… account token (requires DATAFAST_WEBSITE_ID on every request)
# From DataFast → Account settings → API (or: npx @datafast/cli tokens create)
DATAFAST_TOKEN=
# Mongo-style website id (DataFast → dashboard, or: datafast websites list).
# Required with dft_ tokens; ignored with df_ keys. NOT the dfid_ tracking id.
DATAFAST_WEBSITE_ID=
# Tracking id from the website's script snippet (dfid_…) — used by the
# browser SDK (pageviews + datafast_* cookies for Polar revenue attribution)
NEXT_PUBLIC_DATAFAST_WEBSITE_ID=
# Public share URL from DataFast → Website → Share (linked from "see stats →"
# and the footer "Live stats"). Format: https://datafa.st/share/<id>
NEXT_PUBLIC_ANALYTICS_URL=

# ── Homepage side cards (trending / latest activity) ─────────
# Implemented but hidden at launch. Set true to re-enable both cards
# (config-only change: server skips their DB queries and the client skips
# their fetches while unset). Split into two flags later if needed.
NEXT_PUBLIC_SHOW_TRENDING_ACTIVITY=
