# ── Supabase ──────────────────────────────────────────────
# Project URL + anon key (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Postgres connection string (Settings → Database) — for schema/seed scripts
SUPABASE_DB_URL=

# ── Dodo Payments (the payments provider) ────────────────
# https://dodopayments.com · MoR, accepts EG/SA/AE merchants
# Dashboard → Developer: API key (test/live)
DODO_API_KEY=
# Product id of the "Outbid Spot" product — Pay-What-You-Want, $1 minimum,
# one-time, USD (per-checkout amounts = the bid, or the raise difference)
DODO_PRODUCT_ID=
# Signing secret (whsec_…) of the registered webhook endpoint
DODO_WEBHOOK_SECRET=
# test_mode | live_mode
DODO_ENVIRONMENT=test_mode
# Webhook endpoint to register in the dashboard (subscribe to payment.succeeded):
#   staging:  https://staging.outbidarabs.lol/api/webhooks/dodo
#   prod:     https://outbidarabs.lol/api/webhooks/dodo
# (one endpoint per environment — each has its own whsec_)

# ── Site ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Dev fallbacks ───────────────────────────────────────
# When true the site runs fully self-contained: seeded data, simulated
# realtime and a mock checkout. No Supabase/Dodo keys needed.
NEXT_PUBLIC_MOCK_MODE=true

# ── Site ────────────────────────────────────────────────
# Optional: public launch timestamp used by the earnings card / about page
# (defaults to 2026-08-21T20:00:00Z)
NEXT_PUBLIC_LAUNCH_DATE=

# Layer 2 (local Supabase + mock payments): true = rules engine writes to a
# real database without Dodo configured. Local only — never in production.
ALLOW_MOCK_PAYMENTS=

# ── Accounts ────────────────────────────────────────────
# Server secret for anonymous-supporter grouping keys (HMAC — keeps email-derived
# keys from being verifiable by clients). Set a long random value in production
# (openssl rand -hex 32); when unset it falls back to the service-role key or a
# stable dev value.
ACCOUNTS_HASH_SECRET=

# ── Analytics: DataFast (public stats) ─────────────────
# Server-side API token (not NEXT_PUBLIC). Either:
#   df_…  website API key (website implied — DATAFAST_WEBSITE_ID not needed)
#   dft_… account token (requires DATAFAST_WEBSITE_ID on every request)
DATAFAST_TOKEN=
# Mongo-style website id (DataFast → dashboard, or: datafast websites list).
DATAFAST_WEBSITE_ID=
# Tracking id from the website's script snippet (dfid_…)
NEXT_PUBLIC_DATAFAST_WEBSITE_ID=
# Public share URL from DataFast → Website → Share
NEXT_PUBLIC_ANALYTICS_URL=

# ── Homepage side cards (trending / latest activity) ─────────
NEXT_PUBLIC_SHOW_TRENDING_ACTIVITY=
