# ── Supabase ──────────────────────────────────────────────
# Project URL + anon key (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Postgres connection string (Settings → Database) — for schema/seed scripts
SUPABASE_DB_URL=

# ── Polar (payments) ─────────────────────────────────────
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
# Product ID of the "Outbid Spot" product (custom-price enabled)
POLAR_PRODUCT_ID=
# Environment: sandbox | production
POLAR_ENVIRONMENT=sandbox

# ── Site ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Dev fallbacks ───────────────────────────────────────
# When true the site runs fully self-contained: seeded data, simulated
# realtime and a mock checkout. No Supabase/Polar keys needed.
NEXT_PUBLIC_MOCK_MODE=true

# ── Site ────────────────────────────────────────────────
# Optional: public launch timestamp used by the earnings card / about page
# (defaults to 2025-08-21T20:00:00Z)
NEXT_PUBLIC_LAUNCH_DATE=

# Layer 2 (local Supabase + mock payments): true = rules engine writes to a
# real database without Polar configured. Local only — never in production.
ALLOW_MOCK_PAYMENTS=
